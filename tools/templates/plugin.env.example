# ════════════════════════════════════════════════════════════════
#  사緣 묶음(routes\__FOLDER__) 비밀 설정 — 이 파일을 .env 로 복사해서 채운다
#    copy .env.example .env
#  이 값은 사緣만 쓴다 — 그 앱의 환경 변수(web.config appSettings 등)와 섞이지 않는다
#  환경 __ENV__ · DB __DB__ 는 묶을 때 들어갔다 (바꾸려면 아래 DB_HOST · DB_PORT · DB_NAME)
#  고친 뒤: 그 앱의 IIS 앱 풀 재시작
# ════════════════════════════════════════════════════════════════

# ── 세션 ─────────────────────────────────────────────
# 아무도 모르는 긴 무작위 문자열 (예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=
# Web 서버에 https 를 붙이면 true, http 면 false
COOKIE_SECURE=false
# 아무 동작이 없으면 로그아웃까지 시간
SESSION_IDLE_HOURS=8

# ── DB ───────────────────────────────────────────────
# mssql = 운영 DB / memory = 메모리(재시작하면 사라짐, 점검용)
STORE=mssql
# 서버가 평소에 쓰는 앱 계정 (권장: 전용 계정 sayeon_app — node tools\db-setup.mjs 가 만든다)
DB_USER=
DB_PASSWORD=
# 묶을 때 들어간 DB 서버·이름을 바꿀 때만 (비우면 그대로)
DB_HOST=
DB_PORT=
DB_NAME=
# 사내 DB가 TLS를 요구하면 true
DB_ENCRYPT=false
# 사내 자체 서명 인증서면 true
DB_TRUST_CERT=true
# true = DB·테이블이 없으면 처음 시작할 때 만든다. db-setup 으로 미리 만들었으면 false
DB_AUTO_CREATE=true
# node tools\db-setup.mjs 때만 쓰는 관리 계정 (예: sa). 준비가 끝나면 두 줄 모두 지운다
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=

# 이름·메일 암호화 키 (base64 32바이트). 한 번 정하면 바꾸지 말고 따로 안전하게 보관
# 예: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_KEY=

# ── 사내 로그인 ──────────────────────────────────────
# 사내 인사 API 에 인증 키가 필요하면
SSO_API_KEY=
