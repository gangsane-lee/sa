# ════════════════════════════════════════════════════════════════
#  사緣 묶음(routes\__FOLDER__) 비밀 설정 — 이 파일을 .env 로 복사해서 채운다
#    copy .env.example .env
#  이 값은 사緣만 쓴다 — 그 앱의 환경 변수(web.config appSettings 등)와 섞이지 않는다
#  환경 __ENV__ · DB __DB__ 는 묶을 때 들어갔다 (바꾸려면 아래 DB_HOST · DB_PORT · DB_NAME)
#  고친 뒤: 그 앱의 IIS 앱 풀 재시작
# ════════════════════════════════════════════════════════════════

# ── 세션 ─────────────────────────────────────────────
# 아무도 모르는 긴 무작위 문자열 (예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=
# (선택) servers.config.mjs 의 Web 서버 말고도 이 API 를 부를 화면 주소 — 쉼표로 여러 개 (예: http://10.1.2.3:8282)
CORS_ORIGINS=
# 아무 동작이 없으면 로그아웃까지 시간
SESSION_IDLE_HOURS=8

# ── DB ───────────────────────────────────────────────
# mssql = 운영 DB / memory = 메모리(재시작하면 사라짐, 점검용)
STORE=mssql
# 서버가 평소에 쓰는 앱 계정 — 그 앱 main.js 에서 DB 설정을 넘겼으면(설치안내 2번) 비워 둔다
# (사緣 전용 계정을 쓸 때만: 권장 sasystem_app — node tools\db-setup.mjs 가 만든다)
DB_USER=
DB_PASSWORD=
# 묶을 때 들어간 DB 서버·이름을 바꿀 때만 (비우면 그대로)
DB_HOST=
DB_PORT=
DB_NAME=
# 사내 DB가 TLS를 요구하면 true
DB_ENCRYPT=false
# 사내 자체 서명 인증서면 true
DB_TRUST_CERT=true
# true = DB·테이블이 없으면 처음 시작할 때 만든다. db-setup 으로 미리 만들었으면 false
DB_AUTO_CREATE=true
# node tools\db-setup.mjs 때만 쓰는 관리 계정 (예: sa). 준비가 끝나면 두 줄 모두 지운다
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=

# 이름·메일 암호화 키 (base64 32바이트). 한 번 정하면 바꾸지 말고 따로 안전하게 보관
# 예: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_KEY=

# ── 사내 로그인 ──────────────────────────────────────
# 사내 인사 API(sso.hrApi — API 서버가 사번 재확인)에 인증 키가 필요하면
SSO_API_KEY=

# ── 개발 화면(npm run dev) 테스트 사번 로그인 ─────────
# 개발 PC 의 client\.env.development.local 의 SASYSTEM_DEV_KEY 와 같은 값 (16자 이상). 비우면 테스트 사번 로그인이 꺼진다
# 개발 PC IP(servers.config.mjs 의 devServer.host)에서 온 호출만 받는다. 개발을 쉬는 동안은 비워 둔다
# 예: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DEV_LOGIN_KEY=
# (선택) 개발 PC 가 더 있으면 IP 를 쉼표로
DEV_LOGIN_IPS=
