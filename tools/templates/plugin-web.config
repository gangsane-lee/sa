<?xml version="1.0" encoding="UTF-8"?>
<!--
  사緣 묶음 폴더 보호 — 이 폴더의 파일(.env · 관리자 파일 · 서버 코드)을 브라우저가 주소로 내려받지 못하게 막는다.
  사緣 API 요청(/sasystem/api/…)은 그 앱의 main.js 가 처리하므로 영향이 없다.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <fileExtensions allowUnlisted="false" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
