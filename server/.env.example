# ════════════════════════════════════════════════════════════════
#  사緣 API 서버 비밀 설정 — 이 파일을 .env 로 복사해서 채운다 (.env 는 git·배포 패키지에 들어가지 않는다)
#    copy .env.example .env
#  서버 주소·포트·DB 서버/이름·관리자 주소·로그인 방식은 여기가 아니라 저장소 맨 위 servers.config.mjs (마스터)
#  고친 뒤:  npm run check  →  npm run pm2 -- restart sayeon-api
#  전체 순서: docs/GO-LIVE.md
# ════════════════════════════════════════════════════════════════

# 이 서버가 쓸 servers.config.mjs 의 환경 — production(운영) | development(개발)
SAYEON_ENV=production

# ── 세션 ─────────────────────────────────────────────
# 아무도 모르는 긴 무작위 문자열 — 비워 두고 npm run check 를 실행하면 예시 값을 만들어 준다
SESSION_SECRET=
# Web 서버에 https 를 붙이면 true, http 면 false
COOKIE_SECURE=false
# 아무 동작이 없으면 로그아웃까지 시간
SESSION_IDLE_HOURS=8

# ── DB 계정 (서버·DB 이름은 servers.config.mjs) ──────
# mssql = 운영 DB / memory = 메모리(재시작하면 사라짐, 점검용)
STORE=mssql
# 서버가 평소에 쓰는 앱 계정 (권장: 전용 계정 sayeon_app — npm run db:setup 이 만든다)
DB_USER=
DB_PASSWORD=
# 사내 DB가 TLS를 요구하면 true
DB_ENCRYPT=false
# 사내 자체 서명 인증서면 true
DB_TRUST_CERT=true
# true = DB·테이블이 없으면 서버가 처음 켤 때 만든다. npm run db:setup 으로 미리 만들었으면 false
DB_AUTO_CREATE=true
# npm run db:setup 때만 쓰는 관리 계정 (예: sa). 준비가 끝나면 두 줄 모두 지운다
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=

# 이름·메일 암호화 키 (base64 32바이트). 한 번 정하면 바꾸지 말고 따로 안전하게 보관
# 비워 두고 npm run check 를 실행하면 예시 값을 만들어 준다
DATA_KEY=

# ── 사내 로그인 (방식·주소는 servers.config.mjs 의 sso) ──
# 사내 인사 API 에 인증 키가 필요하면 (헤더 이름은 servers.config.mjs 의 sso.hrApi.apiKeyHeader)
SSO_API_KEY=
# 개발 환경(SAYEON_ENV=development)에서만: IIS 없이 이 회사 계정 ID 로 로그인한 것처럼 시험. 운영에서는 무시
DEV_SSO_USER=
