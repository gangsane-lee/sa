# ════════════════════════════════════════════════════════════════
#  사緣 서버 설정 — 이 파일을 .env 로 복사해서 고친다 (.env 는 git에 올라가지 않는다)
#    Windows:  copy .env.example .env      Linux:  cp .env.example .env
#  고친 뒤:   npm run check  →  pm2 restart sayeon-api
#  전체 순서: docs/GO-LIVE.md
# ════════════════════════════════════════════════════════════════

# ── API 서버 · 화면 (12.83.18.17) ─────────────────────
# 서버가 받을 주소·포트 (0.0.0.0 = 모든 네트워크에서 접속 허용)
HOST=0.0.0.0
PORT=3000
# 사람이 접속하는 주소 (로그·안내·점검에 쓴다). PORT 를 바꾸면 같이 바꾼다
PUBLIC_URL=http://12.83.18.17:3000
# 앞단에 IIS·Nginx 리버스 프록시가 있으면 true
TRUST_PROXY=false
# 화면 빌드 결과 위치 (server 폴더 기준). 서버가 이 폴더의 화면도 함께 내보낸다
CLIENT_DIST=../client/dist

# ── 화면 운영 ────────────────────────────────────────
# open = 정식 운영(DB 사용) / test = 시연(각자 브라우저의 가짜 데이터, DB 안 씀)
SERVICE_MODE=open
# 관리자 화면 주소 (사용자 화면에는 버튼이 없고 이 주소로 직접 들어간다)
ADMIN_PATH=/changeme

# ── 세션 ─────────────────────────────────────────────
# 아무도 모르는 긴 무작위 문자열 — 비워 두고 npm run check 를 실행하면 예시 값을 만들어 준다
SESSION_SECRET=
# https 로 접속하면 true, http(IP 주소)로 접속하면 false
COOKIE_SECURE=false
# 아무 동작이 없으면 로그아웃까지 시간
SESSION_IDLE_HOURS=8

# ── DB (MSSQL · 10.166.101.127) ──────────────────────
# mssql = 운영 DB / memory = 메모리(재시작하면 사라짐, 점검용)
STORE=mssql
DB_HOST=10.166.101.127
DB_PORT=1433
DB_NAME=SAYEON
# 서버가 평소에 쓰는 앱 계정 (권장: 전용 계정 sayeon_app — npm run db:setup 이 만든다)
DB_USER=
DB_PASSWORD=
# 사내 DB가 TLS를 요구하면 true
DB_ENCRYPT=false
# 사내 자체 서명 인증서면 true
DB_TRUST_CERT=true
# true = DB·테이블이 없으면 서버가 처음 켤 때 만든다(앱 계정에 만들 권한 필요)
# npm run db:setup 으로 미리 만들었으면 false
DB_AUTO_CREATE=true

# npm run db:setup 때만 쓰는 관리 계정 (DB·로그인을 만들 권한, 예: sa)
# 비우면 DB_USER 로 진행한다. 준비가 끝나면 두 줄 모두 지운다
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=

# 이름·메일 암호화 키 (base64 32바이트). 한 번 정하면 바꾸지 말고 따로 안전하게 보관할 것
# 비워 두고 npm run check 를 실행하면 예시 값을 만들어 준다
DATA_KEY=

# ── 사내 SSO / AD (자세한 연결은 src/sso.js · docs/GO-LIVE.md 4-2) ──
# header = 앞단이 사용자 ID를 헤더로 넘김 / api = SSO 토큰 쿠키를 인증 API로 확인 / off = 로그인 화면만
SSO_MODE=off
# header 모드: 사용자 ID가 들어오는 헤더 이름
SSO_HEADER=x-sso-user
# header 모드 필수: 앞단 프록시가 함께 붙여 주는 비밀값 (이 값이 맞아야 헤더를 믿는다)
SSO_PROXY_SECRET=
SSO_PROXY_SECRET_HEADER=x-sso-secret
# api 모드: SSO 토큰 쿠키 이름과 확인 API (POST {token})
SSO_TOKEN_COOKIE=
SSO_VERIFY_URL=
# 로그인 화면 ID/비밀번호 확인 API (POST {userId, password}) — 비우면 로그인 화면 사용 불가
AUTH_LOGIN_URL=
# 인사정보 조회 API ({empNo} 자리에 사번·계정이 들어간다) — header 모드·블랙리스트 등록에 사용
HR_LOOKUP_URL=
# 임직원 검색 API ({q} 자리에 검색어) — 관리자 블랙리스트 등록 검색 (선택)
HR_SEARCH_URL=
# 사내 API 인증 키가 필요하면
SSO_API_KEY=
SSO_API_KEY_HEADER=x-api-key
# 응답 JSON에서 사용자 정보가 들어 있는 위치 (예: data.user). 맨 바깥이면 비움
SSO_RESULT_PATH=
SSO_TIMEOUT_MS=5000
