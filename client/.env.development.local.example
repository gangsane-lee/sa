# 개발 PC 전용 — 이 파일을 .env.development.local 로 복사해 채운다 (.env.development.local 은 git 에 올라가지 않는다)
#
# 개발 키: API 서버 routes/sayeon/.env 의 DEV_LOGIN_KEY 와 같은 값 (16자 이상, 예: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))")
# npm run dev 의 vite 프록시가 API 서버로 넘길 때만 헤더로 붙인다 — 브라우저 코드에는 들어가지 않는다
SAYEON_DEV_KEY=

# (선택) 운영 API 대신 다른 API 로 시험할 때 — 예: http://127.0.0.1:3999/sayeon
DEV_API_PROXY=
